{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "typeRoots": ["../node_modules/@types", "../node_modules"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"]
}
